svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003eThe design wires ultrasonic and motion sensors through an ESP32 to the base and head motors, with the phone linked over Wi-Fi or Bluetooth.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003eRehab as play: follow-me walks, air piano, a boxing partner, and reaction and memory games.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n    \u003cdiv class=\"chips\"\u003e\u003cspan class=\"chip\"\u003eESP32\u003c/span\u003e\u003cspan class=\"chip\"\u003eLEGO Inventor\u003c/span\u003e\u003cspan class=\"chip\"\u003eUltrasonic sensor\u003c/span\u003e\u003cspan class=\"chip\"\u003eServo motors\u003c/span\u003e\u003cspan class=\"chip\"\u003ePhone as head\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"links\"\u003e\u003ca class=\"btn\" href=\"/work/duo\"\u003eFull write-up\u003c/a\u003e\u003cbutton class=\"btn sl\" data-sl=\"duo\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M4 2h8v12l-4-3-4 3z\"/\u003e\u003c/svg\u003eShortlist\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\n    \n    \u003cdiv class=\"src\"\u003esource · Impact Lab demo: prototype photos and the design sheet\u003c/div\u003e\u003c/article\u003e\u003cdiv class=\"dopts\"\u003e\u003cspan class=\"lbl\"\u003eoptions\u003c/span\u003e\n    \u003ca class=\"btn ask\" href=\"/agent?q=Tell%20me%20about%20DUO\"\u003eAsk the agent about DUO \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\n    \u003ca class=\"btn\" href=\"/agent?q=Internals%20of%20DUO\"\u003eInternals in agent mode\u003c/a\u003e\n    \u003cbutton class=\"btn\" data-next=\"kerala\"\u003eNext: Kerala Immersion ↓\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003