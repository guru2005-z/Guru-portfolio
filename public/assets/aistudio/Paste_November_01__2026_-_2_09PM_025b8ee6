nistic mock\"\u003edeterministic mock\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"simbar\"\u003e\u003cspan class=\"lbl\"\u003esimulate\u003c/span\u003e\u003cbutton class=\"btn\" data-sim=\"-1\" aria-pressed=\"false\"\u003eNormal run\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"0\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eGroq rate-limit\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"1\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eGroq down\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"2\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eNo internet\u003c/button\u003e\u003cspan class=\"simst\" aria-live=\"polite\"\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"body\"\u003e\u003cdiv class=\"ph stack\"\u003e\u003ch3\u003ePACK\u003c/h3\u003e\u003csmall\u003e2026 · Team of two with Mahesh Babu Kona · built the agent game orchestration and dialogue and moved betting off-chain; Mahesh built the MetaMask betting and player mode\u003c/small\u003e\u003c/div\u003e\u003cp class=\"one\"\u003eSeven AI agents play Werewolf; people watch and bet, or take a seat.\u003c/p\u003e\n    \u003cul class=\"facts\"\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"1.5\" y=\"6\" width=\"4\" height=\"4\"/\u003e\u003crect x=\"10.5\" y=\"6\" width=\"4\" height=\"4\"/\u003e\u003cpath d=\"M5.5 8h5\"/\u003e\u003c/svg\u003e\u003cspan\u003eA \u003cmark\u003eLangGraph\u003c/mark\u003e \u003cmark\u003estate machine\u003c/mark\u003e runs setup → night → morning → discussion → voting, with a win check each round.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003e\u003cmark\u003e7 players\u003c/mark\u003e per game (\u003cmark\u003e2 wolves\u003c/mark\u003e, 1 seer, 4 villagers) drawn from \u003cmark\u003e12 characters\u003c/mark\u003e with personas.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"3\" y=\"7\" width=\"10\" height=\"7.5\"/\u003e\u003cpath d=\"M5 7V5a3 3 0 016 0v2\"/\u003e\u003c/svg\u003e\u003cspan\u003eEach agent keeps \u003cmark\u003eprivate reasoning\u003c/mark\u003e separate from its public speech; the UI shows both side by side.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M8 1.5l5.5 2v4c0 3.5-2.5 6-5.5 7-3-1-5.5-3.5-5.5-7v-4z\"/\u003e\u003cpath d=\"M5.5 8l2 2 3-3.5\"/\u003e\u003c/svg\u003e\u003cspan\u003eModel chain: Groq \u003cmark\u003ellama-3.3-70b\u003c/mark\u003e → \u003cmark\u003ellama-3.1-8b\u003c/mark\u003e → OpenAI \u003cmark\u003egpt-4o-mini\u003c/mark\u003e → \u003cmark\u003edeterministic mock\u003c/mark\u003e, so a game never stalls.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"3\" y=\"7\" width=\"10\" height=\"7.5\"/\u003e\u003cpath d=\"M5 7V5a3 3 0 016 0v2\"/\u003e\u003c/svg\u003e\u003cspan\u003eThe server filters hidden roles out of the bettor view.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003eAt the hackathon bets settled on-chain on Monad; the current build uses play money.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n    \u003cdiv class=\"chips\"\u003e\u003cspan class=\"chip\"\u003ePython\u003c/span\u003e\u003cspan class=\"chip\"\u003eFastAPI\u003c/span\u003e\u003cspan class=\"chip\"\u003eLangGraph\u003c/span\u003e\u003cspan class=\"chip\"\u003eGroq\u003c/span\u003e\u003cspan class=\"chip\"\u003eReact\u003c/span\u003e\u003cspan class=\"chip\"\u003eVite\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"links\"\u003e\u003ca class=\"btn\" href=\"https://github.com/rizwan2004cs/Agent-Werewolf\" target=\"_blank\" rel=\"noopener\"\u003eSource \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\u003ca class=\"btn\" href=\"/work/pack\"\u003eFull write-up\u003c/a\u003e\u003cbutton class=\"btn sl\" data-sl=\"pack\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M4 2h8v12l-4-3-4 3z\"/\u003e\u003c/svg\u003eShortlist\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\n    \n    \u003cdiv class=\"src\"\u003esource · Agent-Werewolf: backend/game/graph.py, roster.py, config.py, server.py\u003c/div\u003e\u003c/article\u003e\u003cdiv class=\"dopts\"\u003e\u003cspan class=\"lbl\"\u003eoptions\u003c/span\u003e\n    \u003ca class=\"btn ask\" href=\"/agent?q=How%20does%20PACK%20handle%20failures%3F\"\u003eAsk the agent: how does it handle failures? \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\n    \u003ca class=\"btn\" href=\"/agent?q=Internals%20of%20PACK\"\u003eInternals in agent mode\u003c/a\u003e\n    \u003cbutton class=\"btn\" data-next=\"ccr\"\u003eNext: CCR Compliance Advisor ↓\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cbutton class=\"prow\" data-id=\"ccr\" data-title=\"CCR Compliance Advisor\" aria-expanded=\"false\" aria-controls=\"drawer-ccr\"\u003e\n    \u003cspan class=\"pidx\"\u003eP/02\u003c/span\u003e\u003cspan class=\"ptitle\"\u003eCCR Compliance Advisor\u003c/span\u003e\n    \u003cspan class=\"pstack\"\u003ePython · Crawl4AI · asyncio\u003c/span\u003e\u003cspan class=\"pyear\"\u003e2026\u003c/span\u003e\u003cspan class=\"parr\" aria-hidden=\"true\"\u003e↗\u003c/span\u003e\u003c/button\u003e\n    \u003cdiv class=\"drawer\" id=\"drawer-ccr\"\u003e\u003carticle class=\"panel\" data-id=\"ccr\"\u003e\u003cdiv class=\"arch grid-bg\" data-pid=\"ccr\"\u003e\u003cdiv class=\"flow\"\u003e\u003cspan class=\"n \" data-n=\"crawl\"\u003ecrawl\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"embed\"\u003eembed\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"retrieve k=8\"\u003eretrieve k=8\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n model\" data-n=\"gpt-oss-120b\"\u003egpt-oss-120b\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n end\" data-n=\"answer + sources\"\u003eanswer + sources\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"fb\"\u003eon failure ↘ \u003cspan class=\"n\" data-n=\"gpt-oss-20b\"\u003egpt-oss-20b\u003c/span\u003e\u003cspan class=\"n\" data-n=\"plain notice\"\u003eplain notice\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"simbar\"\u003e\u003cspan class=\"lbl\"\u003esimulate\u003c/span\u003e\u003cbutton class=\"btn\" data-sim=\"-1\" aria-pressed=\"false\"\u003eNormal run\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"0\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eModel retired\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"1\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eBoth models down\u003c/button\u003e\u003cspan class=\"simst\" aria-live=\"polite\"\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"body\"\u003e\u003cdiv class=\"ph\"\u003e\u003ch3\u003eCCR Compliance Advisor\u003c/h3\u003e\u003csmall\u003e2026 · Solo\u003c/small\u003e\u003c/div\u003e\u003cp class=\"one\"\u003eAnswers California regulation questions, citing a section for every claim.\u003c/p\u003e\n    \u003cul class=\"facts\"\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"1.5\" y=\"6\" width=\"4\" height=\"4\"/\u003e\u003crect x=\"10.5\" y=\"6\" width=\"4\" height=\"4\"/\u003e\u003cpath d=\"M5.5 8h5\"/\u003e\u003c/svg\u003e\u003cspan\u003eAsync breadth-first crawl collected \u003cmark\u003e74,975\u003c/mark\u003e of \u003cmark\u003e74,997\u003c/mark\u003e discovered regulation sections (\u003cmark\u003e99.97%\u003c/mark\u003e).\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M8 1.5l5.5 2v4c0 3.5-2.5 6-5.5 7-3-1-5.5-3.5-5.5-7v-4z\"/\u003e\u003cpath d=\"M5.5 8l2 2 3-3.5\"/\u003e\u003c/svg\u003e\u003cspan\u003eExtraction runs \u003cmark\u003e20\u003c/mark\u003e at a time and \u003cmark\u003echeckpoints\u003c/mark\u003e every \u003cmark\u003e100 records\u003c/mark\u003e, so a crash resumes instead of restarting.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cellipse cx=\"8\" cy=\"3.5\" rx=\"5.5\" ry=\"2\"/\u003e\u003cpath d=\"M2.5 3.5v9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-9M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2\"/\u003e\u003c/svg\u003e\u003cspan\u003eSections are embedded (all-MiniLM-L6-v2) into \u003cmark\u003ePinecone\u003c/mark\u003e; the agent retrieves the top 8.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M8 1.5v4M8 10.5v4M1.5 8h4M10.5 8h4M3.5 3.5l2.5 2.5M10 10l2.5 2.5M12.5 3.5L10 6M6 10l-2.5 2.5\"/\u003e\u003c/svg\u003e\u003cspan\u003eThe model answers only from retrieved sections, cites one per claim, and asks a follow-up when context is insufficient.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M8 1.5l5.5 2v4c0 3.5-2.5 6-5.5 7-3-1-5.5-3.5-5.5-7v-4z\"/\u003e\u003cpath d=\"M5.5 8l2 2 3-3.5\"/\u003e\u003c/svg\u003e\u003cspan\u003eConfigurable model with a \u003cmark\u003efallback\u003c/mark\u003e; visitors see a plain message on failure, never a stack trace.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n    \u003cdiv class=\"chips\"\u003e\u003cspan class=\"chip\"\u003ePython\u003c/span\u003e\u003cspan class=\"chip\"\u003eCrawl4AI\u003c/span\u003e\u003cspan class=\"chip\"\u003easyncio\u003c/span\u003e\u003cspan class=\"chip\"\u003ePinecone\u003c/span\u003e\u003cspan class=\"chip\"\u003eGroq\u003c/span\u003e\u003cspan class=\"chip\"\u003eStreamlit\u003c/span\u003e\u003cspan class=\"chip\"\u003eRender\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"links\"\u003e\u003ca class=\"btn\" href=\"https://ccr-compliance-agent.onrender.com/\" target=\"_blank\" rel=\"noopener\" title=\"Free-tier host: the first load can take about 30 seconds\"\u003eLive \u003csmall class=\"wake\"\u003ewakes in ~30s\u003c/small\u003e \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\u003ca class=\"btn\" href=\"https://github.com/rizwan2004cs/ccr_web_crawler\" target=\"_blank\" rel=\"noopener\"\u003eSource \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\u003ca class=\"btn\" href=\"/work/ccr\"\u003eFull write-up\u003c/a\u003e\u003cbutton class=\"btn sl\" data-sl=\"ccr\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M4 2h8v12l-4-3-4 3z\"/\u003e\u003c/svg\u003eShortlist\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\n    \n    \u003cdiv class=\"src\"\u003esource · ccr_web_crawler: crawler/, indexer/ingest.py, agent/app.py\u003c/div\u003e\u003c/article\u003e\u003cdiv class=\"dopts\"\u003e\u003cspan class=\"lbl\"\u003eoptions\u003c/span\u003e\n    \u003ca class=\"btn ask\" href=\"/agent?q=How%20does%20CCR%20Compliance%20Advisor%20handle%20failures%3F\"\u003eAsk the agent: how does it handle failures? \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\n    \u003ca class=\"btn\" href=\"/agent?q=Internals%20of%20CCR%20Compliance%20Advisor\"\u003eInternals in agent mode\u003c/a\u003e\n    \u003cbutton class=\"btn\" data-next=\"finboom\"\u003eNext: FinBoom ↓\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cbutton class=\"prow\" data-id=\"finboom\" data-title=\"FinBoom\" aria-expanded=\"false\" aria-controls=\"drawer-finboom\"\u003e\n    \u003cspan class=\"pidx\"\u003eP/03\u003c/span\u003e\u003cspan class=\"ptitle\"\u003eFinBoom\u003c/span\u003e\n    \u003cspan class=\"pstack\"\u003eNext.js 16 · React 19 · Supabase\u003c/span\u003e\u003cspan class=\"pyear\"\u003e2026\u003c/span\u003e\u003cspan class=\"parr\" aria-hidden=\"true\"\u003e↗\u003c/span\u003e\u003c/button\u003e\n    \u003cdiv class=\"drawer\" id=\"drawer-finboom\"\u003e\u003carticle class=\"panel\" data-id=\"finboom\"\u003e\u003cdiv class=\"arch grid-bg\" data-pid=\"finboom\"\u003e\u003cdiv class=\"flow\"\u003e\u003cspan class=\"n \" data-n=\"voice / text\"\u003evoice / text\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n model\" data-n=\"extract action\"\u003eextract action\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"validate\"\u003evalidate\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"you confirm?\"\u003eyou confirm?\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n end\" data-n=\"write\"\u003ewrite\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"fb\"\u003eon failure ↘ \u003cspan class=\"n\" data-n=\"nothing written\"\u003enothing written\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"simbar\"\u003e\u003cspan class=\"lbl\"\u003esimulate\u003c/span\u003e\u003cbutton class=\"btn\" data-sim=\"-1\" aria-pressed=\"false\"\u003eNormal run\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"0\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eModel returns junk\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"1\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eUser says no\u003c/button\u003e\u003cspan class=\"simst\" aria-live=\"polite\"\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"body\"\u003e\u003cdiv class=\"ph\"\u003e\u003ch3\u003eFinBoom\u003c/h3\u003e\u003csmall\u003e2026 · Solo\u003c/small\u003e\u003c/div\u003e\u003cp class=\"one\"\u003eOffline-first net-worth tracker for India, with an assistant that asks before it acts.\u003c/p\u003e\n    \u003cul class=\"facts\"\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"3\" y=\"7\" width=\"10\" height=\"7.5\"/\u003e\u003cpath d=\"M5 7V5a3 3 0 016 0v2\"/\u003e\u003c/svg\u003e\u003cspan\u003eThe assistant turns speech or text into one \u003cmark\u003evalidated\u003c/mark\u003e action; nothing is written until the user \u003cmark\u003econfirms\u003c/mark\u003e.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cellipse cx=\"8\" cy=\"3.5\" rx=\"5.5\" ry=\"2\"/\u003e\u003cpath d=\"M2.5 3.5v9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-9M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2\"/\u003e\u003c/svg\u003e\u003cspan\u003eThe model has \u003cmark\u003eno database access\u003c/mark\u003e.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"3\" y=\"7\" width=\"10\" height=\"7.5\"/\u003e\u003cpath d=\"M5 7V5a3 3 0 016 0v2\"/\u003e\u003c/svg\u003e\u003cspan\u003eOffline-first PWA with an IndexedDB mutation queue; Supabase with \u003cmark\u003erow-level security\u003c/mark\u003e.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003e\u003cmark\u003e22 asset classes\u003c/mark\u003e, \u003cmark\u003e7 calculators\u003c/mark\u003e, Excel/CSV import, PDF statements.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"1.5\" y=\"6\" width=\"4\" height=\"4\"/\u003e\u003crect x=\"10.5\" y=\"6\" width=\"4\" height=\"4\"/\u003e\u003cpath d=\"M5.5 8h5\"/\u003e\u003c/svg\u003e\u003cspan\u003eBlog pipeline falls back across \u003cmark\u003eGemini\u003c/mark\u003e, Groq and OpenAI.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cellipse cx=\"8\" cy=\"3.5\" rx=\"5.5\" ry=\"2\"/\u003e\u003cpath d=\"M2.5 3.5v9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-9M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2\"/\u003e\u003c/svg\u003e\u003cspan\u003eA React Native (Expo) mobile app reuses the same Clerk and Supabase backend, with an on-device SQLite cache, a mutation queue and a sync engine.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n    \u003cdiv class=\"chips\"\u003e\u003cspan class=\"chip\"\u003eNext.js 16\u003c/span\u003e\u003cspan class=\"chip\"\u003eReact 19\u003c/span\u003e\u003cspan class=\"chip\"\u003eSupabase\u003c/span\u003e\u003cspan class=\"chip\"\u003eClerk\u003c/span\u003e\u003cspan class=\"chip\"\u003eTypeScript\u003c/span\u003e\u003cspan class=\"chip\"\u003eVitest\u003c/span\u003e\u003cspan class=\"chip\"\u003eTailwind CSS\u003c/span\u003e\u003cspan class=\"chip\"\u003eGitHub Actions\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"links\"\u003e\u003ca class=\"btn\" href=\"https://finboom-cyan.vercel.app\" target=\"_blank\" rel=\"noopener\