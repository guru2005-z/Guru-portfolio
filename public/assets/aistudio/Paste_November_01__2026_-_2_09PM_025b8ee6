ode\u003c/a\u003e\n    \u003cbutton class=\"btn\" data-next=\"voice\"\u003eNext: Ten Days of Voice Agents ↓\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cbutton class=\"prow\" data-id=\"voice\" data-title=\"Ten Days of Voice Agents\" aria-expanded=\"false\" aria-controls=\"drawer-voice\"\u003e\n    \u003cspan class=\"pidx\"\u003eP/04\u003c/span\u003e\u003cspan class=\"ptitle\"\u003eTen Days of Voice Agents\u003c/span\u003e\n    \u003cspan class=\"pstack\"\u003ePython · LiveKit Agents · Deepgram\u003c/span\u003e\u003cspan class=\"pyear\"\u003e2025\u003c/span\u003e\u003cspan class=\"parr\" aria-hidden=\"true\"\u003e↗\u003c/span\u003e\u003c/button\u003e\n    \u003cdiv class=\"drawer\" id=\"drawer-voice\"\u003e\u003carticle class=\"panel\" data-id=\"voice\"\u003e\u003cdiv class=\"arch grid-bg\" data-pid=\"voice\"\u003e\u003cdiv class=\"flow\"\u003e\u003cspan class=\"n \" data-n=\"speech\"\u003espeech\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"deepgram stt\"\u003edeepgram stt\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n model\" data-n=\"gemini + tools\"\u003egemini + tools\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"state\"\u003estate\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n end\" data-n=\"murf tts\"\u003emurf tts\u003c/span\u003e\u003c/div\u003e\n    \n    \u003cdiv class=\"simbar\"\u003e\u003cspan class=\"lbl\"\u003esimulate\u003c/span\u003e\u003cbutton class=\"btn\" data-sim=\"-1\" aria-pressed=\"false\"\u003eNormal run\u003c/button\u003e\u003cspan class=\"simst\" aria-live=\"polite\"\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"body\"\u003e\u003cdiv class=\"ph\"\u003e\u003ch3\u003eTen Days of Voice Agents\u003c/h3\u003e\u003csmall\u003e2025 · Solo\u003c/small\u003e\u003c/div\u003e\u003cp class=\"one\"\u003eNine voice agents of his own in Murf AI\u0026#39;s ten-day challenge, one a day after the starter.\u003c/p\u003e\n    \u003cul class=\"facts\"\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003e\u003cspan\u003eEach agent runs on \u003cmark\u003eLiveKit\u003c/mark\u003e Agents with \u003cmark\u003eDeepgram\u003c/mark\u003e nova-3 speech-to-text, \u003cmark\u003eGemini 2.5 Flash\u003c/mark\u003e and \u003cmark\u003eMurf Falcon\u003c/mark\u003e text-to-speech.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"3\" y=\"7\" width=\"10\" height=\"7.5\"/\u003e\u003cpath d=\"M5 7V5a3 3 0 016 0v2\"/\u003e\u003c/svg\u003e\u003cspan\u003eDay 1 brings up Murf\u0026#39;s starter agent; days \u003cmark\u003e2–10\u003c/mark\u003e are nine agents of his own: a coffee barista with a live order receipt, a wellness companion, an active-recall tutor, a Razorpay SDR, a fraud-alert desk with a strict security question, Instamart ordering, a D\u0026amp;D game master, an agentic-commerce shop and an improv game, one branch per day.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003e\u003cspan\u003eEach agent keeps its own structured state (order, lead, fraud case) that the UI renders live.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n    \u003cdiv class=\"chips\"\u003e\u003cspan class=\"chip\"\u003ePython\u003c/span\u003e\u003cspan class=\"chip\"\u003eLiveKit Agents\u003c/span\u003e\u003cspan class=\"chip\"\u003eDeepgram\u003c/span\u003e\u003cspan class=\"chip\"\u003eGemini\u003c/span\u003e\u003cspan class=\"chip\"\u003eMurf Falcon\u003c/span\u003e\u003cspan class=\"chip\"\u003eNext.js\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"links\"\u003e\u003ca class=\"btn\" href=\"https://github.com/rizwan2004cs/ten-days-of-voice-agents-2025\" target=\"_blank\" rel=\"noopener\"\u003eSource \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\u003ca class=\"btn\" href=\"/work/voice\"\u003eFull write-up\u003c/a\u003e\u003cbutton class=\"btn sl\" data-sl=\"voice\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M4 2h8v12l-4-3-4 3z\"/\u003e\u003c/svg\u003eShortlist\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\n    \n    \u003cdiv class=\"src\"\u003esource · ten-days-of-voice-agents-2025: branches Day-1 … day-10\u003c/div\u003e\u003c/article\u003e\u003cdiv class=\"dopts\"\u003e\u003cspan class=\"lbl\"\u003eoptions\u003c/span\u003e\n    \u003ca class=\"btn ask\" href=\"/agent?q=Tell%20me%20about%20Ten%20Days%20of%20Voice%20Agents\"\u003eAsk the agent about Ten Days of Voice Agents \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\n    \u003ca class=\"btn\" href=\"/agent?q=Internals%20of%20Ten%20Days%20of%20Voice%20Agents\"\u003eInternals in agent mode\u003c/a\u003e\n    \u003cbutton class=\"btn\" data-next=\"cpl\"\u003eNext: Campus Premier League ↓\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cbutton class=\"prow\" data-id=\"cpl\" data-title=\"Campus Premier League\" aria-expanded=\"false\" aria-controls=\"drawer-cpl\"\u003e\n    \u003cspan class=\"pidx\"\u003eP/05\u003c/span\u003e\u003cspan class=\"ptitle\"\u003eCampus Premier League\u003c/span\u003e\n    \u003cspan class=\"pstack\"\u003eReact · TypeScript · Supabase\u003c/span\u003e\u003cspan class=\"pyear\"\u003e2026\u003c/span\u003e\u003cspan class=\"parr\" aria-hidden=\"true\"\u003e↗\u003c/span\u003e\u003c/button\u003e\n    \u003cdiv class=\"drawer\" id=\"drawer-cpl\"\u003e\u003carticle class=\"panel\" data-id=\"cpl\"\u003e\u003cdiv class=\"arch grid-bg\" data-pid=\"cpl\"\u003e\u003cdiv class=\"flow\"\u003e\u003cspan class=\"n \" data-n=\"bid\"\u003ebid\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"place_bid() lock\"\u003eplace_bid() lock\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"realtime\"\u003erealtime\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n model\" data-n=\"qwen3.8-27b\"\u003eqwen3.8-27b\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n end\" data-n=\"screens\"\u003escreens\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"fb\"\u003eon failure ↘ \u003cspan class=\"n\" data-n=\"gpt-oss-120b\"\u003egpt-oss-120b\u003c/span\u003e\u003cspan class=\"n\" data-n=\"browser template line\"\u003ebrowser template line\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"simbar\"\u003e\u003cspan class=\"lbl\"\u003esimulate\u003c/span\u003e\u003cbutton class=\"btn\" data-sim=\"-1\" aria-pressed=\"false\"\u003eNormal run\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"0\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eModel timeout\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"1\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eGroq down\u003c/button\u003e\u003cspan class=\"simst\" aria-live=\"polite\"\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"body\"\u003e\u003cdiv class=\"ph stack\"\u003e\u003ch3\u003eCampus Premier League\u003c/h3\u003e\u003csmall\u003e2026 · Solo, with minor help from a friend: a rebuild of an earlier prototype, scaffolded with Lovable\u003c/small\u003e\u003c/div\u003e\u003cp class=\"one\"\u003eA live player auction for a college league, with AI commentary in Telugu.\u003c/p\u003e\n    \u003cul class=\"facts\"\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cellipse cx=\"8\" cy=\"3.5\" rx=\"5.5\" ry=\"2\"/\u003e\u003cpath d=\"M2.5 3.5v9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-9M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2\"/\u003e\u003c/svg\u003e\u003cspan\u003eBids and player releases run as locked Postgres functions, so purse, points and roster always move together.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003e\u003cspan\u003e\u003cmark\u003eSupabase Realtime\u003c/mark\u003e pushes every bid to the projector and to phones.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M8 1.5v4M8 10.5v4M1.5 8h4M10.5 8h4M3.5 3.5l2.5 2.5M10 10l2.5 2.5M12.5 3.5L10 6M6 10l-2.5 2.5\"/\u003e\u003c/svg\u003e\u003cspan\u003eCommentary picks a meme template locally, then Groq personalises it: \u003cmark\u003eqwen3.8-27b\u003c/mark\u003e, then \u003cmark\u003egpt-oss-120b\u003c/mark\u003e, each with an 8s timeout; if both fail, the browser shows a local template line.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003e\u003cmark\u003e87 players\u003c/mark\u003e, 7 franchises, \u003cmark\u003e124\u003c/mark\u003e Telugu meme lines.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n    \u003cdiv class=\"chips\"\u003e\u003cspan class=\"chip\"\u003eReact\u003c/span\u003e\u003cspan class=\"chip\"\u003eTypeScript\u003c/span\u003e\u003cspan class=\"chip\"\u003eSupabase\u003c/span\u003e\u003cspan class=\"chip\"\u003eVercel Functions\u003c/span\u003e\u003cspan class=\"chip\"\u003eGroq\u003c/span\u003e\u003cspan class=\"chip\"\u003eTailwind CSS\u003c/span\u003e\u003cspan class=\"chip\"\u003eGitHub Actions\u003c/span\u003e\u003c/div\u003e\