n    \u003cdiv class=\"simbar\"\u003e\u003cspan class=\"lbl\"\u003esimulate\u003c/span\u003e\u003cbutton class=\"btn\" data-sim=\"-1\" aria-pressed=\"false\"\u003eNormal run\u003c/button\u003e\u003cbutton class=\"btn danger\" data-sim=\"0\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003eClassifier unsure\u003c/button\u003e\u003cspan class=\"simst\" aria-live=\"polite\"\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"body\"\u003e\u003cdiv class=\"ph\"\u003e\u003ch3\u003eVerseYou\u003c/h3\u003e\u003csmall\u003e2025 · Solo\u003c/small\u003e\u003c/div\u003e\u003cp class=\"one\"\u003eAn emotional companion that answers in verse, the way he would, after chatbots never felt like company.\u003c/p\u003e\n    \u003cul class=\"facts\"\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M8 1.5v4M8 10.5v4M1.5 8h4M10.5 8h4M3.5 3.5l2.5 2.5M10 10l2.5 2.5M12.5 3.5L10 6M6 10l-2.5 2.5\"/\u003e\u003c/svg\u003e\u003cspan\u003eThree model steps: classify the message into one of \u003cmark\u003e13\u003c/mark\u003e emotional modes, write a verse with that mode\u0026#39;s own prompt, then add an English translation.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"3\" y=\"7\" width=\"10\" height=\"7.5\"/\u003e\u003cpath d=\"M5 7V5a3 3 0 016 0v2\"/\u003e\u003c/svg\u003e\u003cspan\u003eAn unclear or unknown mode falls back to Safeguard mode, and a flat “I’m fine” is read as hidden hurt, not as fine.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003eNine South Asian languages and scripts (Hindi-Urdu by default, Tamil, Telugu, Bengali and more) with a tone picker; signed-in visitors keep a verse history.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003e\u003cspan\u003eHe built it on Lovable, an AI app builder; it is live at your-souls-echo.lovable.app.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n    \u003cdiv class=\"chips\"\u003e\u003cspan class=\"chip\"\u003eReact\u003c/span\u003e\u003cspan class=\"chip\"\u003eTypeScript\u003c/span\u003e\u003cspan class=\"chip\"\u003eSupabase Edge Functions\u003c/span\u003e\u003cspan class=\"chip\"\u003eGemini 2.5 Flash\u003c/span\u003e\u003cspan class=\"chip\"\u003eLovable\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"links\"\u003e\u003ca class=\"btn\" href=\"https://your-souls-echo.lovable.app/\" target=\"_blank\" rel=\"noopener\"\u003eLive \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\u003ca class=\"btn\" href=\"https://github.com/rizwan2004cs/your-souls-echo\" target=\"_blank\" rel=\"noopener\"\u003eSource \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\u003ca class=\"btn\" href=\"/work/verseyou\"\u003eFull write-up\u003c/a\u003e\u003cbutton class=\"btn sl\" data-sl=\"verseyou\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M4 2h8v12l-4-3-4 3z\"/\u003e\u003c/svg\u003eShortlist\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\n    \n    \u003cdiv class=\"src\"\u003esource · your-souls-echo: supabase/functions/generate-verse/index.ts\u003c/div\u003e\u003c/article\u003e\u003cdiv class=\"dopts\"\u003e\u003cspan class=\"lbl\"\u003eoptions\u003c/span\u003e\n    \u003ca class=\"btn ask\" href=\"/agent?q=How%20does%20VerseYou%20handle%20failures%3F\"\u003eAsk the agent: how does it handle failures? \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\n    \u003ca class=\"btn\" href=\"/agent?q=Internals%20of%20VerseYou\"\u003eInternals in agent mode\u003c/a\u003e\n    \u003cbutton class=\"btn\" data-next=\"pulsevo\"\u003eNext: PULSEVO ↓\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cbutton class=\"prow\" data-id=\"pulsevo\" data-title=\"PULSEVO\" aria-expanded=\"false\" aria-controls=\"drawer-pulsevo\"\u003e\n    \u003cspan class=\"pidx\"\u003eP/09\u003c/span\u003e\u003cspan class=\"ptitle\"\u003ePULSEVO\u003c/span\u003e\n    \u003cspan class=\"pstack\"\u003ePython · FastAPI · Neon Postgres\u003c/span\u003e\u003cspan class=\"pyear\"\u003e2025\u003c/span\u003e\u003cspan class=\"parr\" aria-hidden=\"true\"\u003e↗\u003c/span\u003e\u003c/button\u003e\n    \u003cdiv class=\"drawer\" id=\"drawer-pulsevo\"\u003e\u003carticle class=\"panel\" data-id=\"pulsevo\"\u003e\u003cdiv class=\"arch grid-bg\" data-pid=\"pulsevo\"\u003e\u003cdiv class=\"flow\"\u003e\u003cspan class=\"n \" data-n=\"cron · synthetic org\"\u003ecron · synthetic org\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"FastAPI\"\u003eFastAPI\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n \" data-n=\"Neon Postgres\"\u003eNeon Postgres\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n model\" data-n=\"forecast model\"\u003eforecast model\u003c/span\u003e\u003cspan class=\"ar\"\u003e\u003c/span\u003e\u003cspan class=\"n end\" data-n=\"insights\"\u003einsights\u003c/span\u003e\u003c/div\u003e\n    \n    \u003cdiv class=\"simbar\"\u003e\u003cspan class=\"lbl\"\u003esimulate\u003c/span\u003e\u003cbutton class=\"btn\" data-sim=\"-1\" aria-pressed=\"false\"\u003eNormal run\u003c/button\u003e\u003cspan class=\"simst\" aria-live=\"polite\"\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"body\"\u003e\u003cdiv class=\"ph stack\"\u003e\u003ch3\u003ePULSEVO\u003c/h3\u003e\u003csmall\u003e2025 · Team project · built the frontend and part of the backend\u003c/small\u003e\u003c/div\u003e\u003cp class=\"one\"\u003eTeam productivity dashboard that forecasts task trends, built in 12 hours at his first hackathon.\u003c/p\u003e\n    \u003cul class=\"facts\"\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003eBuilt in \u003cmark\u003e12 hours\u003c/mark\u003e at Terralogic\u0026#39;s Hackathon \u003cmark\u003e2025\u003c/mark\u003e in Nellore, his first hackathon.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cellipse cx=\"8\" cy=\"3.5\" rx=\"5.5\" ry=\"2\"/\u003e\u003cpath d=\"M2.5 3.5v9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-9M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2\"/\u003e\u003c/svg\u003e\u003cspan\u003eFastAPI backend on Neon Postgres; a cron job simulates an organisation at work, generating synthetic tasks and activity.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M8 1.5v4M8 10.5v4M1.5 8h4M10.5 8h4M3.5 3.5l2.5 2.5M10 10l2.5 2.5M12.5 3.5L10 6M6 10l-2.5 2.5\"/\u003e\u003c/svg\u003e\u003cspan\u003eAn in-house model forecasts daily task trends and predicts the probability a task closes within \u003cmark\u003e24 hours\u003c/mark\u003e.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M9 1.5L3 9h4.5L7 14.5 13 7H8.5z\"/\u003e\u003c/svg\u003e\u003cspan\u003eLive KPIs, team performance and an AI summary, plus natural-language questions about the team\u0026#39;s productivity.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\n    \u003cdiv class=\"chips\"\u003e\u003cspan class=\"chip\"\u003ePython\u003c/span\u003e\u003cspan class=\"chip\"\u003eFastAPI\u003c/span\u003e\u003cspan class=\"chip\"\u003eNeon Postgres\u003c/span\u003e\u003cspan class=\"chip\"\u003eReact\u003c/span\u003e\u003cspan class=\"chip\"\u003eTypeScript\u003c/span\u003e\u003cspan class=\"chip\"\u003eVite\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"links\"\u003e\u003ca class=\"btn\" href=\"https://hackathon-frontend-zeta-nine.vercel.app/insights\" target=\"_blank\" rel=\"noopener\"\u003eLive \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\u003ca class=\"btn\" href=\"https://github.com/rizwan2004cs/hackathon-Frontend-\" target=\"_blank\" rel=\"noopener\"\u003eSource \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\u003ca class=\"btn\" href=\"/work/pulsevo\"\u003eFull write-up\u003c/a\u003e\u003cbutton class=\"btn sl\" data-sl=\"pulsevo\" aria-pressed=\"false\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M4 2h8v12l-4-3-4 3z\"/\u003e\u003c/svg\u003eShortlist\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\n    \n    \u003cdiv class=\"src\"\u003esource · hackathon-Frontend-: src/lib/api.ts, src/pages/InsightsNew.tsx, src/pages/QueryNew.tsx\u003c/div\u003e\u003c/article\u003e\u003cdiv class=\"dopts\"\u003e\u003cspan class=\"lbl\"\u003eoptions\u003c/span\u003e\n    \u003ca class=\"btn ask\" href=\"/agent?q=Tell%20me%20about%20PULSEVO\"\u003eAsk the agent about PULSEVO \u003cspan class=\"arr\"\u003e↗\u003c/span\u003e\u003c/a\u003e\n    \u003ca class=\"btn\" href=\"/agent?q=Internals%20of%20PULSEVO\"\u003eInternals in agent mode\u003c/a\u003e\n    \u003cbutton class=\"btn\" data-next=\"ngo\"\u003eNext: NGO Donor Matcher ↓\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/li\u003e\u003cli\u003e\u003cbutton class=\"prow\" data-id=\"ngo\" data-title=\"NGO Donor Matcher\" aria-expanded=\"false\" aria-controls=\"drawer-ngo\"\u003e\n    \u003cspan class=\"pidx\"\u003eP/10\u003c/span\u003e\u003cspan class=\"ptitle\"\u003eNGO Donor Matcher\u003c/span\u003e\n    \u003cspan class=\"pstack\"\u003eSpring Boot · Java 21 · React\u003c/span\u003e\u003cspan class=\"pyear\"\u003e2026\u003c/span\u003e\u003cspan class=\"parr\" aria-hidden=\"true\"\u003e↗\u003c/span\u003e\u003c/button\u003e\n    \u003cdiv class=\"drawer\" id=\"drawer-ngo\"\u003e\u003carticle class=\"panel\" data-id=\"ngo\"\u003e\u003cdiv class=\"shot\"\u003e\u003cimg src=\"/img/ngo-960.jpg\" srcset=\"/img/ngo-480.jpg 480w, /img/ngo-960.jpg 960w, /img/ngo.jpg 1400w\" sizes=\"(max-width:900px) 100vw, 680px\" alt=\"NGO Donor Matcher screenshot\" loading=\"lazy\" decoding=\"async\" class=\"\" data-title=\"NGO Donor Matcher\" style=\"object-position:top\"\u003e\u003c/div\u003e\n    \u003cdiv class=\"body\"\u003e\u003cdiv class=\"ph stack\"\u003e\u003ch3\u003eNGO Donor Matcher\u003c/h3\u003e\u003csmall\u003e2026 · Final-year team project with Dinesh, Gowtham and Sriram\u003c/small\u003e\u003c/div\u003e\u003cp class=\"one\"\u003eDonors find verified NGOs nearby and pledge exactly what they need.\u003c/p\u003e\n    \u003cul class=\"facts\"\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M8 1.5l5.5 2v4c0 3.5-2.5 6-5.5 7-3-1-5.5-3.5-5.5-7v-4z\"/\u003e\u003cpath d=\"M5.5 8l2 2 3-3.5\"/\u003e\u003c/svg\u003e\u003cspan\u003eRadius search uses a haversine query; pledges expire after \u003cmark\u003e48 hours\u003c/mark\u003e via scheduled jobs.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003crect x=\"3\" y=\"7\" width=\"10\" height=\"7.5\"/\u003e\u003cpath d=\"M5 7V5a3 3 0 016 0v2\"/\u003e\u003c/svg\u003e\u003cspan\u003eNGO trust score from 0 to \u003cmark\u003e100\u003c/mark\u003e; donor, NGO and admin roles verified with Firebase tokens.\u003c/span\u003e\u003c/li\u003e\u003cli class=\"fi\"\u003e\u003csvg viewBox=\"0 0 16 16\" aria-hidden=\"true\"\u003e\u003cpath d=\"M6 2L4.5 14M11.5 2L10 14M2.5 5.5h11M2 10.5h11\"/\u003e\u003c/svg\u003e\u003cspan\u003e\u003cmark\u003e71\u003c/mark\u003e Java source files and \u003cmark\u003e15\u003c/mark\u003e test files on Spring Boot 3.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003